{
  "version": 2,
  "routes": [
    {
      "src": "/api/historical-players$",
      "dest": "/api/historical-players.js"
    },
    {
      "src": "/api/news$",
      "dest": "/api/news.js"
    },
    {
      "src": "/api/community$",
      "dest": "/api/community.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    }
  ]
}

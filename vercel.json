{
  "version": 2,
  "routes": [
    {
      "src": "/ads\\.txt$",
      "dest": "/api/ads-txt.js"
    },
    {
      "src": "/api/historical-players$",
      "dest": "/api/historical-players.js"
    },
    {
      "src": "/api/news$",
      "dest": "/api/news.js"
    },
    {
      "src": "/api/match-center$",
      "dest": "/api/match-center.js"
    },
    {
      "src": "/api/community$",
      "dest": "/api/community.js"
    },
    {
      "src": "/api/match-event-enrichment$",
      "dest": "/api/match-event-enrichment.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    }
  ]
}
